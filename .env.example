# LangSmith — tracing and observability
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lca-deepagents
# Non-US region? Uncomment your endpoint (else your API key won't authenticate):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC

# Model provider API keys — set the one you're using
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_API_KEY=your-google-api-key

# OpenRouter: optional, for trying free hosted open-source models (used in the Models lesson)
# Get a free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Tavily web search — for the research labs (Module 4 and the Module 5
# newsletter). Leave blank to run those labs without web search.
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=

# GitHub OAuth app — optionally setup and used in Module 1.6 Lab 2 (MCP OAuth flow).
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# WorkOS AuthKit — user sign-in. Create an app at https://dashboard.workos.com
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...

# Seals the session cookie. This must be a Fernet key, not any 32-character
# string. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable: changing it signs everyone out at once.
WORKOS_COOKIE_PASSWORD=

# Per-user browser credentials are encrypted with this key before they reach
# SQLite. Leave it unset to keep credential storage switched off. Generate one
# with:
#
#     openssl rand -base64 32
#
# Keep it forever: losing it makes every saved credential unrecoverable, and
# changing it locks out everything already stored. It is deliberately separate
# from WORKOS_COOKIE_PASSWORD, so do not reuse that value here.
# TABVIO_CREDENTIAL_KEY=

# The callback URL is derived from the incoming request, so it needs no
# configuration. Register both http://localhost:8000/callback and the deployed
# https://<host>/callback in the WorkOS dashboard. Set this only behind a proxy
# that rewrites the host into something the browser never sees.
# WORKOS_REDIRECT_URI=
