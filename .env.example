# LangSmith — tracing and observability
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lca-deepagents
# Non-US region? Uncomment your endpoint (else your API key won't authenticate):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC

# Model provider API keys — set the one you're using
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_API_KEY=your-google-api-key

# OpenRouter: optional, for trying free hosted open-source models (used in the Models lesson)
# Get a free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Tavily web search — for the research labs (Module 4 and the Module 5
# newsletter). Leave blank to run those labs without web search.
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=

# GitHub OAuth app — optionally setup and used in Module 1.6 Lab 2 (MCP OAuth flow).
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# WorkOS AuthKit — user sign-in. Create an app at https://dashboard.workos.com
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...

# Seals the session cookie. This must be a Fernet key, not any 32-character
# string. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable: changing it signs everyone out at once.
WORKOS_COOKIE_PASSWORD=

# Per-user browser credentials are encrypted with this key before they reach
# SQLite. Leave it unset to keep credential storage switched off. Generate one
# with:
#
#     openssl rand -base64 32
#
# Keep it forever: losing it makes every saved credential unrecoverable, and
# changing it locks out everything already stored. It is deliberately separate
# from WORKOS_COOKIE_PASSWORD, so do not reuse that value here.
# TABVIO_CREDENTIAL_KEY=

# The callback URL is derived from the incoming request, so it needs no
# configuration. Register both http://localhost:8000/callback and the deployed
# https://<host>/callback in the WorkOS dashboard. Set this only behind a proxy
# that rewrites the host into something the browser never sees.
# WORKOS_REDIRECT_URI=

# Which Chrome to drive. Left unset, Playwright's bundled Chromium is used,
# which calls itself HeadlessChrome in its user agent and sec-ch-ua hints and
# is refused by bot detection on sites like Walmart. Set it to "chrome" to
# drive the Google Chrome installed on the machine instead. Pair it with
# TABVIO_HEADLESS=false: headless keeps the HeadlessChrome name whatever the
# channel is.
# TABVIO_BROWSER_CHANNEL=chrome

# Record a Playwright trace of each run's browser session, holding the network
# traffic and console output of every tab it opens. Traces land in the ignored
# data/traces/ directory, one zip per run, and are read with:
#
#     uv run playwright show-trace data/traces/<thread-id>.zip
#
# Leave it off outside of debugging: nothing prunes old traces.
# TABVIO_BROWSER_TRACE=true

# Which agent framework runs the browser agent. "langchain" is the original
# LangGraph build; "strands" is the AWS Strands build on the aws-strands branch.
# Both drive the same browser, credentials, and takeover flow.
# TABVIO_AGENT_ENGINE=strands

# Which models the strands engine talks to. "openai" keeps the models the
# LangChain build uses. "bedrock" needs AWS credentials on the machine and the
# two models enabled in the region below.
# TABVIO_MODEL_PROVIDER=bedrock
# AWS_REGION=us-west-2

# Override either model. Bedrock wants a cross-region inference profile id
# rather than a bare model id; list what your account can reach with:
#
#     aws bedrock list-inference-profiles --region us-west-2
#
# TABVIO_STRONG_MODEL=us.anthropic.claude-sonnet-5
# TABVIO_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
