# Sign-in
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=

# Optional credential storage. Keep this key separate from the cookie key.
TABVIO_CREDENTIAL_KEY=

# Generate a cookie key; preserve existing keys when updating a deployment.
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate a separate credential key: openssl rand -base64 32

# Local agent: OpenAI and bundled Chromium are the defaults.
OPENAI_API_KEY=

# Deployed agent: set the runtime ARN instead of configuring a local model/browser.
# AWS credentials resolve from your profile or role; Railway needs the two keys below.
# TABVIO_AGENTCORE_RUNTIME_ARN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# TABVIO_MAX_CONCURRENT_RUNS=2

# Optional local alternatives: Bedrock uses AWS credentials and defaults to Haiku.
# TABVIO_MODEL_PROVIDER=bedrock
# TABVIO_BROWSER_BACKEND=agentcore
# TABVIO_BROWSER_CHANNEL=chrome
# TABVIO_HEADLESS=false

# Optional debugging
# TABVIO_BROWSER_TRACE=true

# Region defaults to us-west-2; model and browser settings have built-in defaults.
# Callback URLs are derived automatically. Register /callback for each app origin in WorkOS.
