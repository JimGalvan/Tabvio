FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.10.10 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/tabvio-agent/pyproject.toml ./packages/tabvio-agent/pyproject.toml
RUN uv sync --frozen --no-dev --no-install-workspace
COPY tabvio ./tabvio
COPY packages/tabvio-agent/src ./packages/tabvio-agent/src
RUN uv sync --frozen --no-dev
RUN mkdir -p /app/data

EXPOSE 8080
CMD ["sh", "-c", "uvicorn tabvio.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
